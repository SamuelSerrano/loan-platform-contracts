{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.loan-platform.example/schemas/common/get-credit-application-status.schema.json",
  "title": "GetCreditApplicationStatus",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "applicationId"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "activeOffer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "offerId": {
              "type": "string",
              "minLength": 1
            },
            "termsHash": {
              "type": "string",
              "minLength": 1
            },
            "amount": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "minLength": 1
            },
            "termMonths": {
              "type": "integer",
              "minimum": 0
            },
            "installmentAmount": {
              "type": "number"
            },
            "interestRate": {
              "type": "number"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          }
        }
      },
      "required": [
        "applicationId",
        "status"
      ]
    }
  },
  "required": [
    "path",
    "response"
  ]
}
