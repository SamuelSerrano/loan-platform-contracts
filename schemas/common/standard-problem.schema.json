{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.loan-platform.example/schemas/common/standard-problem.schema.json",
  "title": "StandardProblem",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "instance": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "code",
    "traceId"
  ]
}
