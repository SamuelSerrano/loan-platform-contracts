{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.loan-platform.example/schemas/common/submit-credit-application.schema.json",
  "title": "SubmitCreditApplication",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestedAmount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "requestedTermMonths": {
          "type": "integer",
          "minimum": 0
        },
        "consentReferenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "requestedAmount",
        "currency",
        "requestedTermMonths",
        "consentReferenceIds",
        "idempotencyKey"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "IdentityPending"
        }
      },
      "required": [
        "applicationId",
        "status"
      ]
    }
  },
  "required": [
    "request",
    "response"
  ]
}
