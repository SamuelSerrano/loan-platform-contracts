{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.loan-platform.example/schemas/policies/quick-personal-loan-policy.v1.schema.json",
  "title": "QuickPersonalLoanPolicy.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "rulesetVersion": {
      "type": "string",
      "minLength": 1
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1
        },
        "minimumAmount": {
          "type": "number"
        },
        "maximumAmount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "supportedTermMonths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lowFrictionThreshold": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "productId",
        "minimumAmount",
        "maximumAmount",
        "currency",
        "supportedTermMonths",
        "lowFrictionThreshold"
      ]
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumAgeAtApplication": {
          "type": "integer",
          "minimum": 0
        },
        "maximumAgeAtMaturity": {
          "type": "integer",
          "minimum": 0
        },
        "minimumIncome": {
          "type": "number"
        },
        "maximumActiveApplicationsPerCustomer": {
          "type": "integer",
          "minimum": 0
        },
        "maximumActiveLoansPerCustomer": {
          "type": "integer",
          "minimum": 0
        },
        "supportedMarkets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "minimumAgeAtApplication",
        "maximumAgeAtMaturity",
        "minimumIncome",
        "maximumActiveApplicationsPerCustomer",
        "maximumActiveLoansPerCustomer",
        "supportedMarkets"
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumValidScore": {
          "type": "integer",
          "minimum": 0
        },
        "maximumValidScore": {
          "type": "integer",
          "minimum": 0
        },
        "minimumEligibleScore": {
          "type": "integer",
          "minimum": 0
        },
        "riskBands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "band": {
                "type": "string",
                "minLength": 1
              },
              "minimumScore": {
                "type": "integer",
                "minimum": 0
              },
              "maximumScore": {
                "type": "integer",
                "minimum": 0
              },
              "paymentToIncomeLimit": {
                "type": "number"
              },
              "exposureCap": {
                "type": "string",
                "minLength": 1
              },
              "permittedTermMonths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "baseMonthlyEffectiveRate": {
                "type": "number"
              }
            },
            "required": [
              "band",
              "minimumScore",
              "maximumScore",
              "paymentToIncomeLimit",
              "exposureCap",
              "permittedTermMonths",
              "baseMonthlyEffectiveRate"
            ]
          }
        }
      },
      "required": [
        "minimumValidScore",
        "maximumValidScore",
        "minimumEligibleScore",
        "riskBands"
      ]
    },
    "alternatives": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segmentRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "segment": {
                "type": "string",
                "minLength": 1
              },
              "exposureCap": {
                "type": "string",
                "minLength": 1
              },
              "rateAdjustmentPercentagePoints": {
                "type": "number"
              }
            },
            "required": [
              "segment",
              "exposureCap",
              "rateAdjustmentPercentagePoints"
            ]
          }
        },
        "maximumCount": {
          "type": "integer",
          "minimum": 0
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "segmentRules",
        "maximumCount",
        "objectives"
      ]
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validityDuration": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "validityDuration"
      ]
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumMonthlyEffectiveRate": {
          "type": "number"
        }
      },
      "required": [
        "minimumMonthlyEffectiveRate"
      ]
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formulaVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "roundingMode": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "formulaVersions",
        "roundingMode"
      ]
    },
    "reasonCodeCatalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "checksum": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "policyId",
    "policyVersion",
    "rulesetVersion",
    "effectiveFrom",
    "product",
    "eligibility",
    "risk",
    "alternatives",
    "offer",
    "pricing",
    "calculation",
    "reasonCodeCatalogVersion",
    "checksum"
  ]
}
